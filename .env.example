# Snackers Pit Stop — environment variables
#
# Copy this file to `.env.local` for development. Next.js loads `.env.local`
# automatically; scripts load it through `dotenv`.
# Never commit real secrets.

# ---------------------------------------------------------------------------
# Database (server only)
# ---------------------------------------------------------------------------
# Local development: a SQLite file in the project root.
DATABASE_URL="file:local.db"

# Production (Turso): use the libsql:// URL from the Turso dashboard and set
# the token. Leave the token empty for a local file.
# DATABASE_URL="libsql://your-database.turso.io"
# DATABASE_AUTH_TOKEN=""

# ---------------------------------------------------------------------------
# LLM provider (server only) — any OpenAI-compatible API
# ---------------------------------------------------------------------------
# Required for URL imports when a page has no schema.org JSON-LD, and for
# photo imports. The app stays usable without it.
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
# Optional; defaults to LLM_MODEL.
LLM_VISION_MODEL=""
LLM_TIMEOUT_MS="30000"
LLM_MAX_TOKENS="2048"

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
EMBEDDINGS_ENABLED="false"
PHOTO_IMPORT_ENABLED="false"

# ---------------------------------------------------------------------------
# Reverse geocoding (server only)
# ---------------------------------------------------------------------------
GEO_PROVIDER="nominatim"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
# Nominatim's usage policy requires a descriptive User-Agent with contact
# details. Set this before enabling "Use my location" in production.
NOMINATIM_USER_AGENT=""

# ---------------------------------------------------------------------------
# Rate limiting (server only)
# ---------------------------------------------------------------------------
# Salt used to hash client IPs before they touch the rate limiter. Use a long
# random value in production (for example `openssl rand -hex 32`).
RATE_LIMIT_SALT="dev-only-rate-limit-salt"
